{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenDeck",
  "version": "0.1.4",
  "identifier": "io.opendeck.desktop",
  "build": {
    "frontendDist": "../../../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OpenDeck",
        "width": 1500,
        "height": 980,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#0a0e17",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ]
  }
}

