  {
   "id": "set-cue",
   "section": "playback",
   "label": "Set Cue Point",
   "keys": [
    "Ctrl+Digit1",
    "Ctrl+Digit2",
    "Ctrl+Digit3",
    "Ctrl+Digit4",
    "Ctrl+Digit5"
   ],
   "right": [
    "Ctrl+Digit6",
    "Ctrl+Digit7",
    "Ctrl+Digit8",
    "Ctrl+Digit9",
    "Ctrl+Digit0"
   ],
   "index": [
    1,
    2,
    3,
    4,
    5
   ],
   "rightIndex": [
    1,
    2,
    3,
    4,
    5
   ],
   "display": "control + 1 2 3 4 5",
   "rightDisplay": "control + 6 7 8 9 0",
   "status": "implemented"
  },
  {
   "id": "cue",
   "section": "playback",
   "label": "Set/Jump to Cue Point",
   "keys": [
    "Digit1",
    "Digit2",
    "Digit3",
    "Digit4",
    "Digit5"
   ],
   "right": [
    "Digit6",
    "Digit7",
    "Digit8",
    "Digit9",
    "Digit0"
   ],
   "index": [
    1,
    2,
    3,
    4,
    5
   ],
   "rightIndex": [
    1,
    2,
    3,
    4,
    5
   ],
   "display": "1 2 3 4 5",
   "rightDisplay": "6 7 8 9 0",
   "hold": true,
   "status": "implemented",
   "note": "Sets the cue when empty, jumps when set. With SLIP on, releasing the key returns to the timeline."
  },
